<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Parte superior: título y total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/azul"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/total_gastado"
            android:textColor="@color/blanco"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="@color/blanco"
            android:textSize="40sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Formulario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/campoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/campo"
            android:hint="@string/hint_descripcion"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_suave"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/campoMonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/campo"
            android:hint="@string/hint_monto"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_suave"
            android:textSize="20sp" />

        <Button
            android:id="@+id/botonAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/boton_principal"
            android:minHeight="56dp"
            android:text="@string/agregar_gasto"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lista de gastos -->
    <ListView
        android:id="@+id/listaGastos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:paddingBottom="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp" />

    <!-- Se muestra solo cuando la lista está vacía -->
    <TextView
        android:id="@+id/textoVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/sin_gastos"
        android:textColor="@color/texto_suave"
        android:textSize="18sp" />

</LinearLayout>
